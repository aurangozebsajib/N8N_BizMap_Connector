# Gemini API Key (Optional for server-side generative planner)
GEMINI_API_KEY=

# Google Service Account JSON (stringified JSON)
GOOGLE_SERVICE_JSON=

# Google Docs & Sheets IDs
STORY_STORAGE_DOC=
API_KEYS_SHEET=
MODEL_STORAGE_SHEET=

# Telegram Integration (optional dispatcher)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# Hugging Face API Key (optional for remote AI models)
HUGGINGFACE_API_KEY=

# n8n Webhook Endpoint
N8N_WEBHOOK_URL=

# Pipeline configuration
CHARACTER_MODE=per_video
LOCAL_FALLBACK=true
UPLOAD_CATBOX=false
